# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=secrets-vault

# Backend selection (required): vault | infisical | aws | gcp | azure
# SECRETS_BACKEND=vault
# SECRETS_PREFIX=muxcore/
# SECRETS_GRPC_ADDR=:9500

# Vault / OpenBao
# VAULT_ADDR=http://127.0.0.1:8200
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_KV_MOUNT=secret
# VAULT_CACERT=
# VAULT_SKIP_VERIFY=false

# Infisical
# INFISICAL_API_URL=https://app.infisical.com
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_TOKEN=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENV=dev

# AWS Secrets Manager (standard AWS SDK credentials / role)
# AWS_SECRETS_REGION=us-east-1

# GCP Secret Manager
# GCP_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Azure Key Vault
# AZURE_KEY_VAULT_URL=https://my-vault.vault.azure.net/
